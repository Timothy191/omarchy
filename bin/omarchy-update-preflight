#!/bin/bash
# omarchy:group=update
# omarchy:name=preflight
# omarchy:summary=Validate update prerequisites without modifying the system.
# omarchy:args=[--json]

set -u -o pipefail

json=0
[[ ${1:-} == "--json" ]] && json=1

checks=()
statuses=()
details=()

add_check() {
  checks+=("$1"); statuses+=("$2"); details+=("$3")
}

run_check() {
  local name="$1" detail="$2"
  if eval "$detail"; then
    add_check "$name" ok "passed"
  else
    add_check "$name" fail "failed"
  fi
}

free_bytes=""
if read -r free_bytes < <(df --output=avail --block-size=1 / 2>/dev/null | tail -n 1) &&
   [[ "$free_bytes" =~ ^[0-9]+$ ]] &&
   (( free_bytes >= 10 * 1024 * 1024 * 1024 )); then
  add_check "disk-space" ok "at least 10 GiB available"
else
  add_check "disk-space" fail "less than 10 GiB available or unable to determine free space"
fi

if command -v pacman >/dev/null 2>&1; then
  if [[ -e /var/lib/pacman/db.lck ]]; then
    add_check "pacman-lock" fail "pacman transaction lock is present"
  else
    add_check "pacman-lock" ok "no pacman transaction is active"
  fi
else
  add_check "pacman" fail "pacman is unavailable"
fi

if command -v omarchy-update-lock >/dev/null 2>&1 && omarchy-update-lock held; then
  add_check "omarchy-lock" fail "another Omarchy update is already running"
else
  add_check "omarchy-lock" ok "no Omarchy update is running"
fi

if command -v systemctl >/dev/null 2>&1 && systemctl is-system-running >/dev/null 2>&1; then
  add_check "systemd" ok "system manager is operational"
else
  add_check "systemd" warn "system manager is degraded or unavailable"
fi

if command -v omarchy-migrate >/dev/null 2>&1; then
  if omarchy-migrate --pending >/dev/null 2>&1; then
    add_check "migrations" warn "pending migrations exist"
  else
    add_check "migrations" ok "no pending migrations reported"
  fi
else
  add_check "migrations" warn "migration command unavailable"
fi

if (( json )); then
  printf '{"checks":['
  for i in "${!checks[@]}"; do
    (( i )) && printf ','
    printf '{"name":"%s","status":"%s","detail":"%s"}' "${checks[i]}" "${statuses[i]}" "${details[i]}"
  done
  printf ']}\n'
else
  printf '%-16s %-5s %s\n' CHECK STATE DETAIL
  for i in "${!checks[@]}"; do
    printf '%-16s %-5s %s\n' "${checks[i]}" "${statuses[i]}" "${details[i]}"
  done
fi

for status in "${statuses[@]}"; do
  [[ "$status" == fail ]] && exit 1
done
exit 0
