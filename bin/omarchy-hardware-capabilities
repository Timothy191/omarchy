#!/bin/bash
# omarchy:group=hw
# omarchy:name=capabilities
# omarchy:summary=Report detected hardware capabilities for scripts and support tools.
# omarchy:args=[--json]

set -u

json=0
[[ ${1:-} == "--json" ]] && json=1

gpu_vendor="unknown"
if command -v lspci >/dev/null 2>&1; then
  gpu_line=$(lspci 2>/dev/null | grep -Ei 'VGA compatible controller|3D controller|Display controller' | head -n 1 || true)
  case "$gpu_line" in
    *NVIDIA*) gpu_vendor=nvidia ;;
    *AMD*|*ATI*) gpu_vendor=amd ;;
    *Intel*) gpu_vendor=intel ;;
    "") gpu_vendor=none ;;
  esac
fi

has_nvidia=0; command -v nvidia-smi >/dev/null 2>&1 && has_nvidia=1
has_hyprland=0; command -v hyprctl >/dev/null 2>&1 && has_hyprland=1
has_waybar=0; command -v waybar >/dev/null 2>&1 && has_waybar=1
has_battery=0; compgen -G "/sys/class/power_supply/BAT*" >/dev/null 2>&1 && has_battery=1

if (( json )); then
  printf '{"gpu_vendor":"%s","nvidia_smi":%s,"hyprland":%s,"waybar":%s,"battery":%s}\n'     "$gpu_vendor" "$has_nvidia" "$has_hyprland" "$has_waybar" "$has_battery"
else
  printf 'gpu_vendor=%s\n' "$gpu_vendor"
  printf 'nvidia_smi=%s\n' "$has_nvidia"
  printf 'hyprland=%s\n' "$has_hyprland"
  printf 'waybar=%s\n' "$has_waybar"
  printf 'battery=%s\n' "$has_battery"
fi
