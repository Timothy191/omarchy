#!/bin/bash
# omarchy:group=state
# omarchy:name=state-export
# omarchy:summary=Export Omarchy persistent state as JSON without changing it.

set -u -o pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"

command -v jq >/dev/null 2>&1 || {
  echo "state export requires jq" >&2
  exit 127
}

entries=()

if [[ -d $STATE_DIR ]]; then
  while IFS= read -r -d '' file; do
    entries+=("$(basename -- "$file")")
  done < <(find "$STATE_DIR" -maxdepth 1 -type f -print0 | sort -z)
fi

printf '%s\n' "${entries[@]}" |
  jq -R -s --arg state_dir "$STATE_DIR" '
    split("\n")
    | map(select(length > 0)) as $entries
    | {state_dir: $state_dir, entries: $entries}
  '
